# Copiez ce fichier en ".env" (jamais committé) et remplacez les valeurs.
# SA_PASSWORD : 8 caractères minimum avec majuscule, minuscule, chiffre et symbole. Évitez le point-virgule.
SA_PASSWORD=ChangeMe_Str0ng!
# JWT_KEY : 32 caractères minimum. Générez-la avec la commande indiquée dans le README.
JWT_KEY=
# ADMIN_PASSWORD : mot de passe du compte admin@shop.local (laissez vide pour ne pas créer d'admin)
ADMIN_PASSWORD=
